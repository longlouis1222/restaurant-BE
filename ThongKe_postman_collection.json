{
  "info": {
    "name": "Restaurant Thong Ke",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection test cac API thong ke (ban an, mon an, doanh thu, nguyen lieu, nha cung cap, luong nhan vien)"
  },
  "item": [
    {
      "name": "Thong ke tan suat mon theo thang",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/bao-cao/mon-an/thong-ke-theo-thang?nam={{nam}}&thang={{thang}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "bao-cao", "mon-an", "thong-ke-theo-thang"],
          "query": [
            { "key": "nam", "value": "{{nam}}" },
            { "key": "thang", "value": "{{thang}}" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Top mon ban chay theo khoang thoi gian",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/bao-cao/mon-an/top?fromDate={{fromDate}}&toDate={{toDate}}&page={{page}}&size={{size}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "bao-cao", "mon-an", "top"],
          "query": [
            { "key": "fromDate", "value": "{{fromDate}}" },
            { "key": "toDate", "value": "{{toDate}}" },
            { "key": "page", "value": "{{page}}" },
            { "key": "size", "value": "{{size}}" }
          ]
        }
      },
      "response": []
